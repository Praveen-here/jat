# Copy this file to `.env` and fill in the values. `.env` is git-ignored: never commit secrets.

# Environment: development | test | production
NODE_ENV=development
LOG_LEVEL=info

# Public URL of the web app (the browser talks to the API through it via /api rewrites)
APP_URL=http://localhost:3000

# PostgreSQL connection.
# Local Docker (pnpm db:up):
DATABASE_URL=postgresql://tracker:tracker@localhost:5433/tracker
# Throwaway database for automated tests (wiped by tests). Never point this at real data.
TEST_DATABASE_URL=postgresql://tracker:tracker@localhost:5433/tracker_test
# Supabase (later): use the "Session pooler" string from Connect, port 5432, e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Google OAuth (needed from task 2; see docs/SETUP.md step 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App secrets (needed from task 3). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
HMAC_PEPPER=

# AI classification with Groq (optional). Get a key at console.groq.com → API Keys, and turn on
# Zero Data Retention in Settings → Data Controls. Leave empty to classify with rules only.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AI_ENABLED=true
